# Host ports for the docker-compose stack. Change any that clash with something
# already running on your machine (e.g. a local Postgres on 5432, or Apache on
# 8080), then `docker compose up --build`.

FRONTEND_PORT=8080
BACKEND_PORT=8081
POSTGRES_PORT=5432

# Optional — enables cross-network peers (TURN relay). Without these, only peers
# on the same local network can connect. Get them from the Cloudflare dashboard
# (Calls / TURN). See DEPLOY.md.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_API_TOKEN=
